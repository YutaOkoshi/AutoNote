# share-to-repo の設定。写して config.env にし、値を埋める（KEY="値" の形。$HOME と ~ は使える。コマンドは実行されない）。
# 置き場所の既定: ~/Library/Application Support/AutoNoteShare/config.env（別の場所なら環境変数 SHARE_CONFIG で指す）。
# 環境変数で同じ名前を渡すと、そちらが勝つ。
# 説明は値の行の上に書く（値の後ろに # で書いたものは読み飛ばすが、読み間違いのもとなので書かない）。

# --- 置き場（git） ---
# 会議記録のリポジトリの clone（スクリプト専用。人は触らない）
SHARE_REPO_DIR="$HOME/Library/Application Support/AutoNoteShare/repo"
SHARE_REMOTE="origin"
# 置き場のブランチ名。置き場の既定のブランチに合わせる（clone で git branch --show-current と打つと分かる）
SHARE_BRANCH="main"
# 知らせに入れる議事録へのリンクの元（例 https://github.com/<owner>/<repo>）。空ならリンクなし
REPO_WEB_URL=""

# --- 読むもの・書くもの ---
# AutoNote の出力フォルダ（年ごとのフォルダの親）。スクリプトは読むだけ
VAULT_ROOT="$HOME/Documents/AutoNote"
SHARE_STATE_DIR="$HOME/Library/Application Support/AutoNoteShare/state"
SHARE_LOG_DIR="$HOME/Library/Application Support/AutoNoteShare/logs"
# 録画の受け取り箱（同期フォルダ）。空の間は、共有から 7 日後に「録画は消しましたか」を 1 回だけ出す
# （その運用では、消したことを share-meeting.sh --recording-deleted <autonote_id> で記録する）
# 置いてもらう形式は AutoNote が取り込める mp4・m4a・mp3・wav。見回りは直下のその 4 つと mov を録画として数える
INBOX_DIR=""

# --- 人の呼び名（議事録の recorded_by と知らせの文に入る） ---
DEFAULT_RECORDED_BY="録画した人"
OWNER_NAME="オーナー"
# 録画を消すまでの日数（知らせの期日と、雛形の案内文に入る）と、持ち主あてに知らせるまでの日数
# 置き場の README.md を作った後で変えたら、README.md の日数は手で直す（写しの「はじめに」は自動で変わる）
RECORDING_KEEP_DAYS="7"
RECORDING_OWNER_DAYS="21"

# --- 知らせ ---
# macos（既定。この Mac の通知 + state/notices.md。持ち主にしか届かない）
# slack（Incoming Webhook。録画した人・読む人に届けるなら、そのチャンネルに入れておく）
# dry-run（送らずに state/outbox-dry/ に書くだけ）
# 要対応のことは、どれを選んでも state/todo.md にも書く
NOTIFY_MODE="macos"
# macos のとき、osascript の代わりに呼ぶコマンド（引数 $1=題 $2=本文）。空なら osascript
NOTIFY_CMD=""
# slack のとき。URL は秘密なので、ここに直接書かず 1Password の参照を使う（1 回の実行で 1 度だけ op read で取り出す）
SLACK_WEBHOOK_OP_REF=""
# op（1Password の CLI）の場所。launchd の見回りから使うなら絶対パスで書く（ターミナルで command -v op と打った結果。
# 例 /opt/homebrew/bin/op）。launchd の PATH には Homebrew のフォルダが無いので、空のままだと見回りは op を見つけられない
OP_CMD=""
# Webhook の URL を直接渡す場合は、この行ではなく環境変数 SLACK_WEBHOOK_URL で渡すほうがよい
# SLACK_WEBHOOK_URL=""

# --- 読む人向けの写し（任意） ---
# 同期フォルダ（例: Google ドライブのデスクトップ版が同期するフォルダの中）。空なら写さない
MIRROR_DIR=""
# docx（既定） / md / docx,md
MIRROR_FORMAT="docx"
# 知らせに入れる、写しのフォルダの URL（あれば REPO_WEB_URL より優先する）
MIRROR_WEB_URL=""

# --- 見回り ---
# AutoNote の CLI。設定すると、AutoNote から消えた共有の会議を知らせる。空なら飛ばす
# （例 /Applications/AutoNote.app/Contents/MacOS/autonote。AutoNote が起動していなければ CLI が起動しようとする）
AUTONOTE_CLI=""
