# share-to-repo の設定。写して config.env にし、値を埋める（KEY="値" の形。$HOME と ~ は使える。コマンドは実行されない）。
# 置き場所の既定: ~/Library/Application Support/AutoNoteShare/config.env（別の場所なら環境変数 SHARE_CONFIG で指す）。
# 環境変数で同じ名前を渡すと、そちらが勝つ。

# --- 置き場（git） ---
# 会議記録のリポジトリの clone（スクリプト専用。人は触らない）
SHARE_REPO_DIR="$HOME/Library/Application Support/AutoNoteShare/repo"
SHARE_REMOTE="origin"
SHARE_BRANCH="main"
# 知らせに入れる議事録へのリンクの元（例 https://github.com/<owner>/<repo>）。空ならリンクなし
REPO_WEB_URL=""

# --- 読むもの・書くもの ---
# AutoNote の出力フォルダ（年ごとのフォルダの親）。スクリプトは読むだけ
VAULT_ROOT="$HOME/Documents/AutoNote"
SHARE_STATE_DIR="$HOME/Library/Application Support/AutoNoteShare/state"
SHARE_LOG_DIR="$HOME/Library/Application Support/AutoNoteShare/logs"
# 録画の受け取り箱（同期フォルダ）。空の間は、共有から 7 日後に「録画は消しましたか」を 1 回だけ出す
INBOX_DIR=""

# --- 人の呼び名（議事録の recorded_by と知らせの文に入る） ---
DEFAULT_RECORDED_BY="録画した人"
OWNER_NAME="オーナー"
RECORDING_KEEP_DAYS="7"
RECORDING_OWNER_DAYS="21"

# --- 知らせ ---
# macos（既定。Mac の通知 + state/todo.md） / slack（Incoming Webhook） / dry-run（state/outbox-dry/ に書くだけ）
NOTIFY_MODE="macos"
# macos のとき、osascript の代わりに呼ぶコマンド（引数 $1=題 $2=本文）。空なら osascript
NOTIFY_CMD=""
# slack のとき。URL は秘密なので、ここに直接書かず 1Password の参照を使う（op read で取り出す）
SLACK_WEBHOOK_OP_REF=""
# SLACK_WEBHOOK_URL=""   # 直接渡す場合（環境変数で渡すほうがよい）

# --- 読む人向けの写し（任意） ---
# 同期フォルダ（例: Google ドライブのデスクトップ版が同期するフォルダの中）。空なら写さない
MIRROR_DIR=""
# docx（既定） / md / docx,md
MIRROR_FORMAT="docx"
# 知らせに入れる、写しのフォルダの URL（あれば REPO_WEB_URL より優先する）
MIRROR_WEB_URL=""

# --- 見回り ---
# AutoNote の CLI。設定すると、AutoNote から消えた共有の会議を知らせる。空なら飛ばす
# （例 /Applications/AutoNote.app/Contents/MacOS/autonote。AutoNote が起動していなければ CLI が起動しようとする）
AUTONOTE_CLI=""
